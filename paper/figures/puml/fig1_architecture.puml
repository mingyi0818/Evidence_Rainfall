@startuml fig1_architecture
skinparam dpi 300
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.5

skinparam rectangle {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  BorderThickness 1.5
}

skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #95A5A6
  BorderStyle dashed
  BorderThickness 1.0
}

rectangle "Input\nWeather Features (123-dim)" as INPUT #D5E8D4

package "MLP Backbone" {
  rectangle "Hidden Layer 1\n[128] + BatchNorm + ReLU + Dropout(0.3)" as H1 #DAE8FC
  rectangle "Hidden Layer 2\n[64] + BatchNorm + ReLU + Dropout(0.3)" as H2 #DAE8FC
  rectangle "Hidden Layer 3\n[32] + BatchNorm + ReLU + Dropout(0.3)" as H3 #DAE8FC
}

rectangle "Linear Layer + Softplus\nProduces non-negative evidence" as EVIDENCE #FFE6CC

rectangle "Dirichlet Parameterization\nCombines evidence with prior" as DIR #D5E8D4

package "Prior Options" {
  rectangle "Uniform prior" as PRIOR_U #F5F5F5
  rectangle "Climatology-anchored prior" as PRIOR_C #F5F5F5
}

rectangle "Predictive Distribution\nClass probabilities from Dirichlet" as PRED #FFE6CC

package "Uncertainty Decomposition" {
  rectangle "Total uncertainty" as HT #F8CECC
  rectangle "Aleatoric uncertainty" as HA #F8CECC
  rectangle "Epistemic uncertainty" as HE #F8CECC
}

rectangle "Masked KL Regularizer\nTraining loss with annealing" as LOSS #E1D5E7

INPUT --> H1
H1 --> H2
H2 --> H3
H3 --> EVIDENCE
EVIDENCE --> DIR
PRIOR_U --> DIR
PRIOR_C --> DIR
DIR --> PRED
DIR --> HT
DIR --> HA
HA --> HE
HT --> HE
DIR --> LOSS

@enduml
